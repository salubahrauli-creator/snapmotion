# ============================================
# BACKEND CONFIGURATION
# ============================================

# Server
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000

# Database
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=snapmotion
DB_USER=postgres
DB_PASSWORD=your_strong_password_here

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# ============================================
# GOOGLE CLOUD CONFIGURATION
# ============================================

# Google Cloud Project
GOOGLE_PROJECT_ID=your-project-id
GOOGLE_CLOUD_KEYFILE=./config/google-cloud-key.json

# Google Cloud Storage
GOOGLE_STORAGE_BUCKET=your-bucket-name
GOOGLE_STORAGE_URL=https://storage.googleapis.com

# Firebase (Alternative)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# ============================================
# ADMIN CREDENTIALS
# ============================================

ADMIN_EMAIL=admin@snapmotion.com
ADMIN_PASSWORD=Str0ng!P@ssw0rd#123
ADMIN_DEFAULT_USERNAME=admin

# ============================================
# EMAIL CONFIGURATION
# ============================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@snapmotion.com

# ============================================
# FRONTEND CONFIGURATION
# ============================================

# Web
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_APP_NAME=SnapMotion

# Mobile
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_SOCKET_URL=http://localhost:5000

# ============================================
# SECURITY
# ============================================

CORS_ORIGIN=http://localhost:3000,http://localhost:8081
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# LOGGING
# ============================================

LOG_LEVEL=debug
LOG_FILE=./logs/app.log

# ============================================
# PAYMENT (OPTIONAL - Future)
# ============================================

STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
